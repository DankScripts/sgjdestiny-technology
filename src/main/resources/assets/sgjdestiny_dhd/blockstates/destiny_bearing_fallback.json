{
  "multipart": [
    { "when": {"facing":"north"}, "apply": {"model":"sgjdestiny_dhd:block/destiny_bearing_fallback"} },
    { "when": {"facing":"east"}, "apply": {"model":"sgjdestiny_dhd:block/destiny_bearing_fallback","y":90} },
    { "when": {"facing":"south"}, "apply": {"model":"sgjdestiny_dhd:block/destiny_bearing_fallback","y":180} },
    { "when": {"facing":"west"}, "apply": {"model":"sgjdestiny_dhd:block/destiny_bearing_fallback","y":270} },
    { "when": {"facing":"north","lit":"true","flashing":"false"}, "apply": {"model":"sgjdestiny_dhd:block/lit_destiny_bearing"} },
    { "when": {"facing":"east","lit":"true","flashing":"false"}, "apply": {"model":"sgjdestiny_dhd:block/lit_destiny_bearing","y":90} },
    { "when": {"facing":"south","lit":"true","flashing":"false"}, "apply": {"model":"sgjdestiny_dhd:block/lit_destiny_bearing","y":180} },
    { "when": {"facing":"west","lit":"true","flashing":"false"}, "apply": {"model":"sgjdestiny_dhd:block/lit_destiny_bearing","y":270} },
    { "when": {"facing":"north","lit":"true","flashing":"true"}, "apply": {"model":"sgjdestiny_dhd:block/bright_destiny_bearing"} },
    { "when": {"facing":"east","lit":"true","flashing":"true"}, "apply": {"model":"sgjdestiny_dhd:block/bright_destiny_bearing","y":90} },
    { "when": {"facing":"south","lit":"true","flashing":"true"}, "apply": {"model":"sgjdestiny_dhd:block/bright_destiny_bearing","y":180} },
    { "when": {"facing":"west","lit":"true","flashing":"true"}, "apply": {"model":"sgjdestiny_dhd:block/bright_destiny_bearing","y":270} }
  ]
}
